package stream

import (
	"github.com/zweiundeins/lith/site/internal/demo"
	"github.com/zweiundeins/lith/site/internal/ds"
	"github.com/zweiundeins/lith/site/internal/views"
)

// Stage is the demo on its page: the readout of the tab's own stream, the
// site's streams and their budget, and the payload with its controls. Only
// the table is morphed; the reports and the choices arrive as signals.
templ Stage(st TabState, p Payload) {
	<div class="sx" data-signals={ NewSignals(st).Decl() } data-on-interval__duration.1s={ tick }>
		<section class="sx-panel sx-readout" aria-labelledby="stream-readout-title">
			<header class="sx-head">
				<h3 id="stream-readout-title" class="sx-eyebrow">Your stream</h3>
				<p class="sx-pace" data-class:is-live={ demo.Live } data-class:is-quiet={ silent }>
					<span class="sx-dot" aria-hidden="true"></span>
					<span data-show={ ds.Not(demo.Live) }>connecting</span>
					<span data-show={ ds.And(demo.Live, silent) } style="display: none">quiet for <b data-text={ S.Quiet }>0</b> s</span>
					<span data-show={ ds.And(demo.Live, ds.Not(silent)) } style="display: none"><b data-text={ S.FPS }>0</b> frames a second</span>
				</p>
			</header>
			<div class="sx-encoder">
				<p class="sx-coding" data-attr:data-coding={ S.Coding } data-text={ or(S.Coding, "…") }>…</p>
				<dl class="sx-pairs">
					<div>
						<dt>Setting from the budget</dt>
						<dd><code data-text={ or(S.Tier, "waiting") }>waiting</code></dd>
					</div>
					<div>
						<dt>Reserved for your encoder</dt>
						<dd data-text={ or(S.Heap, "waiting") }>waiting</dd>
					</div>
				</dl>
			</div>
			<div class="sx-heroes" data-class:is-ready={ reported }>
				<div class="sx-hero">
					<p class="sx-big" data-class:is-fine={ S.FR.Lt(100) }>
						<span class="sx-count sx-count--ratio" aria-hidden="true" data-style:--stream-count={ S.FR }></span>
						<span class="sx-unit" aria-hidden="true">:1</span>
						<span class="visually-hidden" data-text={ ratioWords }></span>
					</p>
					<p class="sx-caption">The last frame, events to wire</p>
					<div class="sx-bars" aria-hidden="true">
						<p class="sx-bar"><span>events</span><i style="--stream-fill: 100"></i><b data-text={ S.FE }></b></p>
						<p class="sx-bar is-wire"><span>wire</span><i data-style:--stream-fill={ S.FP }></i><b data-text={ S.FWT }></b></p>
					</div>
				</div>
				<div class="sx-hero">
					<p class="sx-big" data-class:is-kb={ kilobytes }>
						<span class="sx-count sx-count--bytes" aria-hidden="true" data-style:--stream-count={ S.FW }></span>
						<span class="sx-unit sx-unit--spaced" aria-hidden="true" data-text={ frameUnit }>B</span>
						<span class="visually-hidden" data-text={ S.FWT }></span>
					</p>
					<p class="sx-caption">On the wire, frame by frame</p>
					<sb-sparkline class="sx-spark" length="60" tone="brand" label="Bytes on the wire per frame" data-effect={ push }></sb-sparkline>
				</div>
			</div>
			<dl class="sx-tiles">
				<div>
					<dt>Events sent</dt>
					<dd data-text={ S.Events }></dd>
				</div>
				<div>
					<dt>On the wire</dt>
					<dd data-text={ S.Wire }></dd>
				</div>
				<div>
					<dt>Ratio so far</dt>
					<dd data-text={ S.Total }></dd>
				</div>
				<div>
					<dt>Heartbeats</dt>
					<dd data-text={ S.Beats }></dd>
				</div>
			</dl>
		</section>
		<section class="sx-panel sx-site" aria-labelledby="stream-site-title">
			<header class="sx-head">
				<h3 id="stream-site-title" class="sx-eyebrow">The site</h3>
				<p class="sx-streams"><b data-text={ S.Streams }>0</b> <span data-text={ streamsText }>streams open on this site</span></p>
			</header>
			<sb-meter class="sx-meter" label="Budget for the streams" unit="%" segments="24" value="0" data-attr:value={ budgetValue } data-preserve-attr="value" data-show={ limited } style="display: none"></sb-meter>
			<p class="sx-budget">
				<b data-text={ or(S.Reserved, "nothing") }>nothing</b> reserved
				<span data-show={ limited } style="display: none">of a limit of <b data-text={ S.Limit }></b></span>
				<span data-show={ ds.Not(limited) }>: this process has no memory limit, so the budget only counts</span>
			</p>
			<p class="sx-tiers" data-show={ S.Tiers } style="display: none">By setting: <span data-text={ S.Tiers }></span></p>
		</section>
		<section class="sx-panel sx-payload" aria-labelledby="stream-payload-title">
			<header class="sx-head">
				<h3 id="stream-payload-title" class="sx-eyebrow">The payload</h3>
				<div class="sx-controls" data-on:datastar-fetch={ fetched } data-effect={ settle } data-on-signal-patch={ op.LostExpr() } data-on-signal-patch-filter={ op.LostFilter() }>
					@choiceGroup("size", "Size", sizeOptions(st))
					@choiceGroup("churn", "Churn", churnOptions(st))
				</div>
			</header>
			<p class="outcome is-problem" role="alert" data-show={ S.Problem } data-text={ S.Problem }></p>
			@note(p)
			<div class="sx-scroll" tabindex="0" role="region" aria-label="The payload table">
				@table(p)
			</div>
		</section>
	</div>
}

// choiceGroup is a row of buttons, the tab's choice pressed. The server
// presses them through the tab's signals; a click only marks its button
// pending.
templ choiceGroup(field, label string, options []option) {
	<div class="sx-choice" role="group" aria-labelledby={ "stream-" + field + "-label" }>
		<span id={ "stream-" + field + "-label" } class="sx-label">{ label }</span>
		<div class="choice">
			for _, o := range options {
				<button
					type="button"
					aria-pressed={ pressedText(o.on) }
					data-attr:aria-pressed={ o.pressed }
					data-attr:aria-busy={ o.busy }
					data-on:click={ o.choose }
				>{ o.label }</button>
			}
		</div>
	</div>
}

func pressedText(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

// Table is the frame the tab's table view sends every step: the note and
// the table, each morphed into the page by its id. Cells that changed in
// the step carry data-new, which lights them up.
templ Table(p Payload) {
	@note(p)
	@table(p)
}

templ note(p Payload) {
	<p id="stream-payload-note" class="sx-note">{ caption(p) }</p>
}

templ table(p Payload) {
	<table id="stream-payload" class="sx-table">
		<thead>
			<tr>
				<th scope="col">node</th>
				for _, c := range columns {
					<th scope="col">{ c }</th>
				}
			</tr>
		</thead>
		<tbody>
			for _, r := range p.Rows {
				<tr>
					<th scope="row">{ r.Name }</th>
					for _, c := range r.Cells {
						<td data-new?={ c.New }>{ c.Text }</td>
					}
				</tr>
			}
		</tbody>
	</table>
}

// Embed is the landing page's slot: this page's own stream, from the
// reports its writes carry.
templ Embed() {
	<div class="sx-embed" data-signals={ NewSignals(TabState{}).Decl() }>
		<p class="sx-embed__head" data-class:is-live={ demo.Live }><span class="sx-dot" aria-hidden="true"></span>This page's stream, live</p>
		<div class="sx-embed__body">
			<p class="sx-coding" data-attr:data-coding={ S.Coding } data-text={ or(S.Coding, "…") }>…</p>
			<p class="sx-embed__tier"><code data-text={ or(S.Tier, "waiting") }>waiting</code> from the memory budget</p>
		</div>
		<dl class="sx-embed__nums">
			<div>
				<dt>Frames</dt>
				<dd data-text={ S.N }>0</dd>
			</div>
			<div>
				<dt>Ratio so far</dt>
				<dd data-text={ or(S.Total, "1:1") }>1:1</dd>
			</div>
			<div>
				<dt>Last frame</dt>
				<dd data-text={ lastFrame }>waiting</dd>
			</div>
		</dl>
		<p class="sx-embed__note" data-show={ S.N.Le(1) }>The first frame has no frame before it to refer back to. The frames after it do, and cost far less.</p>
		<sb-sparkline class="sx-spark" length="40" tone="brand" label="Bytes on the wire per frame of this page's stream" data-show={ S.N.Ge(3) } style="display: none" data-effect={ push }></sb-sparkline>
		<a class="btn btn--sm" href="/demos/stream">
			Inspect every number
			@views.Icon("arrow-right")
		</a>
	</div>
}
