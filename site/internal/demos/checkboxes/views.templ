package checkboxes

import "strconv"

// Stage is the demo on its page: the numbers, the jump field, and the grid
// at the tab's window, its tiles drawn from the document's read. The
// stage holds the signals; no frame morphs it. data-checkboxes mounts its
// controller (checkboxes.ts) once its signals are declared: it sends the
// clicks, which the stage posts, the windows, which their own elements
// post, and keeps the boxes that wait.
templ Stage(w Window, tiles []shown, s Stats) {
	<div
		class="cb"
		data-signals={ NewSignals().Decl() }
		data-checkboxes
		{ setPosts... }
		{ templ.Attributes{"data-style:" + PropPitch: pitch}... }
	>
		<span hidden data-window { windowPosts... }></span>
		<span hidden data-greet { greetPosts... }></span>
		<form class={ ClassJump }>
			<label for="checkboxes-jump">Go to box</label>
			<div class="cb-jump__row">
				<input id="checkboxes-jump" class="input" type="number" min="1" max={ strconv.Itoa(Boxes) } step="1" inputmode="numeric" placeholder="500000" data-bind={ S.Jump.Path() }/>
				<button class="btn" type="submit">Go</button>
			</div>
		</form>
		@StatsBar(s)
		<p class="outcome is-problem cb__problem" role="alert" style="display: none" data-show={ S.Problem.String() } data-text={ S.Problem.String() }></p>
		<div class={ ClassFrame }>
			<div class="cb-where" aria-hidden="true">
				<span>#1</span>
				<i class="cb-where__rail"><b class="cb-where__mark"></b></i>
				<span>#{ grouped(Boxes) }</span>
			</div>
			@Board(w, tiles)
		</div>
		<div class="cb__foot">
			<p class="cb__hint">Tick a box, and every tab that shows it sees it change within a tick. Your box blinks until the server's frame brings its new state.</p>
			<ul class="cb-legend" role="list" aria-label="Key">
				<li><i class="cb-key"></i>clear</li>
				<li><i class="cb-key is-on"></i>checked</li>
				<li><i class="cb-key is-sent"></i>sent, waiting</li>
			</ul>
		</div>
	</div>
}

// StatsBar is the numbers, one view for everyone.
templ StatsBar(s Stats) {
	<dl id={ IdStats } class="cb-stats">
		<div class="cb-stat">
			<dt>boxes checked</dt>
			<dd>{ grouped(s.Checked) }</dd>
		</div>
		<div class="cb-stat cb-stat--rate">
			<dt>toggles per second</dt>
			<dd>{ grouped(s.PerSecond()) }</dd>
			<sb-sparkline class="cb-stat__trend" values={ rateJSON(s.Rate) } length={ strconv.Itoa(Trend) } scale="fixed" min="0" max={ strconv.Itoa(s.Peak()) } tone="brand" label="Toggles per second, the last 30 seconds"></sb-sparkline>
		</div>
		<div class="cb-stat">
			<dt>people here</dt>
			<dd>{ grouped(s.Here) }</dd>
		</div>
	</dl>
}

// Board is the list at a window: Starbase's sb-virtual-scroll, its items
// the window's slots, chunk n's tile in slot n % Slots. The page measures
// its tiles per row and row height (columns, item-size). Slots outside
// the window wait in the park, so that a chunk's frame always finds its
// slot. tiles holds the window's chunks for the GET document; the tab's
// view sends the slots empty, and data-ignore-morph keeps their tiles. A
// stream's first frame of it asks the page for its window (Hello).
templ Board(w Window, tiles []shown) {
	<div id={ IdBoard } class="cb-board">
		<sb-virtual-scroll
			id={ IdGrid }
			class="cb-grid"
			label="A million checkboxes"
			item-size={ strconv.Itoa(defaultItem) }
			columns={ strconv.Itoa(defaultCols) }
			buffer="240"
			total={ strconv.Itoa(Chunks) }
			offset={ strconv.Itoa(w.Start) }
			data-attr:columns={ S.Cols.String() }
			data-attr:item-size={ S.Item.String() }
			data-preserve-attr="columns item-size"
		>
			for n := w.Start; n < w.End(); n++ {
				<div id={ slotID(slot(n)) } class={ ClassSlot } data-ignore-morph>
					if tiles != nil {
						@tile(n, tiles[n-w.Start].bits, tiles[n-w.Start].watching)
					}
				</div>
			}
		</sb-virtual-scroll>
		<div class="cb-park" hidden>
			for _, s := range parked(w) {
				<div id={ slotID(s) } class={ ClassSlot } data-ignore-morph></div>
			}
		</div>
	</div>
}
